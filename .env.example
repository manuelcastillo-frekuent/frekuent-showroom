# demo = simulated payments (default, safe for fairs) · s2s = real payments over WebSocket to the showroom server
VITE_PAYMENT_MODE=demo
# WebSocket of the showroom server (s2s mode). Local: ../showroom-bff (pnpm start)
VITE_WS_URL=ws://localhost:8787
# 1 = version A (86″, machine at 1:1) · 0.76 = version B (65″)
VITE_MACHINE_SCALE=1
