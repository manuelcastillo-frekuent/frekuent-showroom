# demo = simulated payments (default, safe for fairs) · s2s = real payments, straight to the services (no BFF)
VITE_PAYMENT_MODE=demo
# Payments service over HTTP (s2s mode). Local: ../showroom-bff (pnpm start) simulates it
VITE_API_URL=http://localhost:8787/api
# Machine channel for the dispense order and result (s2s mode). Local: ../showroom-bff
VITE_WS_URL=ws://localhost:8787
# 1 = version A (86″, machine at 1:1) · 0.76 = version B (65″)
VITE_MACHINE_SCALE=1
